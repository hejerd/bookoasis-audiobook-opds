+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+import OpdsTracksView from '@/app/player/components/OpdsTracksView';
+vi.mock('@/hooks/useTranslation', () => ({ useTranslation: () => (key: string) => key }));
+afterEach(cleanup);
+const tracks = [1, 2, 3].map((n) => ({
+  href: `https://audio.test/${n}.mp3`,
+  mimeType: 'audio/mpeg',
+  title: `${n}화 파일.mp3`,
+}));
+describe('OPDS playlist view', () => {
+  it('lists all files and selects a middle file by its original index', () => {
+    const select = vi.fn();
+    render(<OpdsTracksView tracks={tracks} onSelect={select} />);
+    expect(screen.getAllByRole('listitem')).toHaveLength(3);
+    fireEvent.click(screen.getByRole('button', { name: /2화 파일/ }));
+    expect(select).toHaveBeenCalledWith(1);
+  });
+  it('preserves the real index when searching and exposes the current and pending files', () => {
+    const select = vi.fn();
+    render(<OpdsTracksView tracks={tracks} activeIndex={1} pendingIndex={2} onSelect={select} />);
+    expect(screen.getByRole('button', { name: /2화 파일/ }).getAttribute('aria-current')).toBe(
+      'true',
+    );
+    fireEvent.change(screen.getByRole('searchbox'), { target: { value: '3화' } });
+    expect(screen.getAllByRole('listitem')).toHaveLength(1);
+    expect(screen.getByRole('status', { name: 'Preparing track' })).toBeTruthy();
+    fireEvent.click(screen.getByRole('button', { name: /3화 파일/ }));
+    expect(select).toHaveBeenCalledWith(2);
+  });
+});
--- a/apps/readest-app/src/__tests__/services/opds/playlist-controller.test.ts
+++ b/apps/readest-app/src/__tests__/services/opds/playlist-controller.test.ts
@@ -0,0 +1,109 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { AudiobookController } from '@/services/audiobook/AudiobookController';
+import type { AudiobookClock } from '@/services/audiobook/AudiobookClock';
+class Clock extends EventTarget implements AudiobookClock {
+  currentTime = 0;
+  playbackRate = 1;
+  paused = true;
+  url = '';
+  async load(url: string, at: number) {
+    this.url = url;
+    this.currentTime = at;
+  }
+  async play() {
+    this.paused = false;
+  }
+  pause() {
+    this.paused = true;
+  }
+  destroy() {
+    this.pause();
+  }
+}
+const track = (index: number) => ({
+  index: 0,
+  startOffset: 0,
+  duration: 100 + index,
+  contentUrl: `https://audio.test/${index}.mp3`,
+  mimeType: 'audio/mpeg',
+});
+const controllers: AudiobookController[] = [];
+afterEach(async () => {
+  await Promise.all(controllers.splice(0).map((c) => c.shutdown()));
+});
+const setup = () => {
+  const clock = new Clock();
+  const loadTrack = vi.fn(async (index: number) => track(index));
+  const source = {
+    itemId: 'book',
+    title: 'Book',
+    author: 'A',
+    tracks: [track(0)],
+    chapters: [],
+    startAt: 0,
+    resolveUrl: (url: string) => url,
+    playlist: { titles: ['1화', '2화', '3화'], index: 0, loadTrack },
+  };
+  const controller = new AudiobookController(source, clock);
+  controllers.push(controller);
+  return { clock, controller, loadTrack };
+};
+describe('OPDS track playlist', () => {
+  it('lists every track without fetching the other track lengths', () => {
+    const { controller, loadTrack } = setup();
+    expect(controller.getChapters().map((c) => c.title)).toEqual(['1화', '2화', '3화']);
+    expect(loadTrack).not.toHaveBeenCalled();
+  });
+  it('plays a selected middle track without loading earlier tracks', async () => {
+    const { controller, clock, loadTrack } = setup();
+    await controller.seekToChapter(2);
+    expect(loadTrack.mock.calls).toEqual([[2]]);
+    expect(clock.url).toBe('https://audio.test/2.mp3');
+    expect(clock.paused).toBe(false);
+    expect(controller.getPlaybackInfo()?.duration).toBe(102);
+  });
+  it('advances automatically and honors stop at chapter end', async () => {
+    const { controller, clock, loadTrack } = setup();
+    await controller.start();
+    clock.currentTime = 100;
+    clock.dispatchEvent(new Event('ended'));
+    await vi.waitFor(() => expect(clock.url).toBe('https://audio.test/1.mp3'));
+    expect(loadTrack.mock.calls).toEqual([[1]]);
+    controller.stopAtChapterEnd = true;
+    clock.currentTime = 101;
+    clock.dispatchEvent(new Event('ended'));
+    await vi.waitFor(() => expect(clock.url).toBe('https://audio.test/2.mp3'));
+    expect(clock.paused).toBe(true);
+  });
+  it('keeps the latest selection when requests finish out of order', async () => {
+    const { controller, clock, loadTrack } = setup();
+    let release!: (value: ReturnType<typeof track>) => void;
+    loadTrack.mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          release = resolve;
+        }),
+    );
+    const older = controller.seekToChapter(1);
+    await controller.seekToChapter(2);
+    release(track(1));
+    await older;
+    expect(clock.url).toBe('https://audio.test/2.mp3');
+  });
+  it('does not resume a pending selection after pause', async () => {
+    const { controller, clock, loadTrack } = setup();
+    let release!: (value: ReturnType<typeof track>) => void;
+    loadTrack.mockImplementationOnce(
+      () =>
+        new Promise((resolve) => {
+          release = resolve;
+        }),
+    );
+    const loading = controller.seekToChapter(1);
+    await controller.pause();
+    release(track(1));
+    await loading;
+    expect(clock.url).toBe('https://audio.test/1.mp3');
+    expect(clock.paused).toBe(true);
+  });
+});
