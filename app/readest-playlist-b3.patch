+/** Thrown when a password-protected catalog is opened on the web platform. */
+export class OpdsAudioWebAuthError extends Error {
+  constructor() {
+    super('opds-audio-web-auth');
+    this.name = 'OpdsAudioWebAuthError';
+  }
+}
