+/** At least one track's duration could not be read, so the timeline is wrong. */
+export class OpdsAudioIncompleteError extends Error {
+  constructor() {
+    super('opds-audio-incomplete');
+    this.name = 'OpdsAudioIncompleteError';
+  }
